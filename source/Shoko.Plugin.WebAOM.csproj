<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Shoko WebAOM Renamer</Title>
        <Authors>Shoko Team</Authors>
        <Version>1.0.2</Version>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <PropertyGroup Label="Plugin">
        <PluginGenerateClass>true</PluginGenerateClass>
        <PluginID>8c8d75f2-cd0c-5c0b-9a9e-8c2c6d3e5f1a</PluginID>
        <PluginName>WebAOM</PluginName>
        <PluginOverview>The legacy renamer, based on WebAOM's renamer. It covers basic file names and gets no new features. For a folder structure of your own or several managed folders, use the Lua renamer or a custom relocation provider.</PluginOverview>
        <PluginTags>relocator,relocation-provider,renamer</PluginTags>
        <PluginIcon>Assets/icon.svg</PluginIcon>
        <PluginThumbnail>Assets/thumbnail.svg</PluginThumbnail>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shoko.Plugin.WebAOM.Tests" />
    </ItemGroup>

    <!-- The server supplies the abstractions at runtime, and a plugin that
         ships its own copy resolves `IPlugin` against that copy and is then
         skipped without an error, so the dll and the packages it brings stay
         out of the output. -->
    <ItemGroup Condition="'$(ShokoRepositoryPath)' != ''">
        <ProjectReference Include="$(ShokoRepositoryPath)/Shoko.Abstractions/Shoko.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
        <!-- Checks the plugin's configurations and actions with the analyzer,
             which is only built from a checkout. -->
        <ProjectReference Include="$(ShokoRepositoryPath)/Shoko.BuildTools.Analyzers/Shoko.BuildTools.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(ShokoRepositoryPath)' == ''">
        <PackageReference Include="Shoko.Abstractions" Version="$(ShokoAbstractionsVersion)" ExcludeAssets="runtime" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- Injects the embedded plugin identity metadata the server reads during
             discovery, from the `Plugin` properties above, and generates the
             plugin class. -->
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.6.0" PrivateAssets="All" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
